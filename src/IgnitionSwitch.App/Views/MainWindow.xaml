<Window
    x:Class="IgnitionSwitch.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:IgnitionSwitch.App.Controls"
    Title="IgnitionSwitch">
    <Grid Background="{StaticResource RootBackground}" RequestedTheme="Dark">
        <ScrollViewer
            x:Name="WorkspaceScroll"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto">
            <Grid x:Name="WorkspaceRoot" Padding="24,20,24,12" RowSpacing="16"
                MinHeight="{Binding ViewportHeight, ElementName=WorkspaceScroll}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="490" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Height="36" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Path
                            Width="18"
                            Height="24"
                            Data="M 13,0 L 2,17 L 11,17 L 7,29 L 24,10 L 14,10 L 18,0 Z"
                            Fill="{StaticResource AccentBrush}"
                            Stretch="Uniform" />
                        <TextBlock Text="IgnitionSwitch" FontSize="19" FontWeight="SemiBold"
                            Foreground="{StaticResource PrimaryText}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock
                        x:Name="SessionTitleText"
                        Grid.Column="1"
                        Text="Untitled"
                        Margin="8,0,0,0"
                        FontSize="13"
                        Foreground="{StaticResource MutedText}"
                        TextTrimming="CharacterEllipsis"
                        VerticalAlignment="Center" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                        <Button x:Name="OpenButton" Content="Open" Style="{StaticResource QuietButtonStyle}"
                            AutomationProperties.Name="Open a session" />
                        <Button x:Name="SaveButton" Content="Save" Style="{StaticResource QuietButtonStyle}"
                            AutomationProperties.Name="Save session" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6">
                        <Button x:Name="DeviceButton" Style="{StaticResource QuietButtonStyle}"
                            AutomationProperties.Name="Devices and audio">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse x:Name="DeviceStatusDot" Width="6" Height="6"
                                    Fill="{StaticResource MutedText}" VerticalAlignment="Center" />
                                <TextBlock x:Name="DeviceNameText" Text="Devices" />
                                <FontIcon Glyph="&#xE70D;" FontSize="9" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedRight">
                                    <StackPanel Width="290" Spacing="16" RequestedTheme="Dark">
                                        <TextBlock Text="Devices" Style="{StaticResource FlyoutHeadingStyle}" />
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="Controller" Style="{StaticResource SectionLabelStyle}" />
                                            <TextBlock
                                                x:Name="ConnectionText"
                                                Text="Looking for your controller…"
                                                Style="{StaticResource BodyStyle}"
                                                AutomationProperties.LiveSetting="Polite" />
                                            <Button x:Name="ReconnectButton" Content="Reconnect"
                                                Style="{StaticResource QuietButtonStyle}"
                                                HorizontalAlignment="Left"
                                                AutomationProperties.Name="Reconnect controller and audio" />
                                        </StackPanel>
                                        <Border Height="1" Background="{StaticResource BorderBrush}" />
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="Audio output" Style="{StaticResource SectionLabelStyle}" />
                                            <TextBlock x:Name="AudioText" Text="Preparing audio…"
                                                Style="{StaticResource BodyStyle}"
                                                AutomationProperties.LiveSetting="Polite" />
                                        </StackPanel>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Button x:Name="HelpButton" Content="?" Style="{StaticResource IconButtonStyle}"
                            ToolTipService.ToolTip="Keyboard shortcuts"
                            AutomationProperties.Name="Keyboard shortcuts">
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedRight">
                                    <StackPanel Width="232" Spacing="16" RequestedTheme="Dark">
                                        <TextBlock Text="Keyboard shortcuts" Style="{StaticResource FlyoutHeadingStyle}" />
                                        <Grid ColumnSpacing="18" RowSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="56" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Space" Style="{StaticResource ShortcutKeyStyle}" />
                                            <TextBlock Grid.Column="1" Text="Play / pause" Style="{StaticResource BodyStyle}" />
                                            <TextBlock Grid.Row="1" Text="R" Style="{StaticResource ShortcutKeyStyle}" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="Record" Style="{StaticResource BodyStyle}" />
                                            <TextBlock Grid.Row="2" Text="Esc" Style="{StaticResource ShortcutKeyStyle}" />
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="Stop" Style="{StaticResource BodyStyle}" />
                                        </Grid>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="16,11">
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button
                                x:Name="PlayButton"
                                Width="104"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Background="{StaticResource AccentBrush}"
                                Foreground="#17130F"
                                BorderBrush="{StaticResource AccentBrush}"
                                AutomationProperties.Name="Play or pause loop">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon x:Name="PlayIcon" Glyph="&#xE768;" FontSize="13" />
                                    <TextBlock x:Name="PlayLabel" Text="Play" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="StopButton" Width="40" Padding="0"
                                Style="{StaticResource ToolbarButtonStyle}"
                                ToolTipService.ToolTip="Stop and rewind"
                                AutomationProperties.Name="Stop and rewind">
                                <FontIcon Glyph="&#xE71A;" FontSize="13" />
                            </Button>
                            <Button x:Name="RecordButton" Width="124"
                                Style="{StaticResource ToolbarButtonStyle}"
                                AutomationProperties.Name="Toggle recording">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Ellipse Width="8" Height="8" Fill="#F48694" VerticalAlignment="Center" />
                                    <TextBlock x:Name="RecordLabel" Text="Record" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <Grid Grid.Column="1" ColumnSpacing="12" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="1" Height="28" Background="{StaticResource BorderBrush}" />
                            <NumberBox x:Name="TempoBox" Grid.Column="1" Width="90"
                                Minimum="60" Maximum="180" Value="100" SmallChange="1"
                                SpinButtonPlacementMode="Compact"
                                FontSize="14" FontFamily="Cascadia Mono"
                                AutomationProperties.Name="Tempo in beats per minute" />
                            <TextBlock Grid.Column="2" Text="BPM" FontSize="11"
                                Foreground="{StaticResource MutedText}" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock
                            x:Name="PositionText"
                            Grid.Column="2"
                            Text="Bar 1 · beat 1"
                            FontSize="12"
                            FontFamily="Cascadia Mono"
                            Foreground="{StaticResource MutedText}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Loop position" />
                        <Grid Grid.Column="3" ColumnSpacing="18" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ToggleButton x:Name="MetronomeToggle" Width="36" Height="36" Padding="0"
                                CornerRadius="7" Background="Transparent" BorderBrush="Transparent"
                                ToolTipService.ToolTip="Metronome" AutomationProperties.Name="Toggle metronome">
                                <FontIcon Glyph="&#xE916;" FontSize="16" />
                            </ToggleButton>
                            <Grid Grid.Column="1" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="126" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Master" FontSize="12" Foreground="{StaticResource MutedText}"
                                    VerticalAlignment="Center" />
                                <Slider x:Name="MasterSlider" Grid.Column="1"
                                    Style="{StaticResource CompactSliderStyle}"
                                    Minimum="0" Maximum="1" Value="0.65" StepFrequency="0.01"
                                    AutomationProperties.Name="Master volume" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <Grid x:Name="WorkspaceBody" Grid.Row="2" MinHeight="490">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="TrackColumn" Width="244" MinWidth="200" MaxWidth="360" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" MinWidth="480" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CardStyle}">
                        <Grid RowSpacing="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Tracks" Style="{StaticResource PanelHeadingStyle}" />
                            <StackPanel x:Name="TrackPanel" Grid.Row="1" Spacing="4" />
                            <Grid Grid.Row="2" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ToggleButton x:Name="MuteButton" Content="Mute" Height="34"
                                    HorizontalAlignment="Stretch" CornerRadius="7"
                                    AutomationProperties.Name="Mute selected track" />
                                <Button x:Name="ClearButton" Grid.Column="1" Content="Clear"
                                    Style="{StaticResource QuietButtonStyle}"
                                    HorizontalAlignment="Stretch"
                                    ToolTipService.ToolTip="Clear selected track"
                                    AutomationProperties.Name="Clear selected track" />
                            </Grid>
                        </Grid>
                    </Border>
                    <controls:ResizeHandle
                        x:Name="TrackResizeHandle"
                        Grid.Column="1"
                        Axis="Horizontal"
                        Style="{StaticResource ColumnResizeHandleStyle}"
                        ToolTipService.ToolTip="Resize tracks"
                        AutomationProperties.Name="Resize track panel"
                        AutomationProperties.HelpText="Drag left or right, or use the left and right arrow keys." />
                    <Grid x:Name="EditorGrid" Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition x:Name="LoopRow" Height="*" MinHeight="230" />
                            <RowDefinition Height="12" />
                            <RowDefinition x:Name="DrumsRow" Height="*" MinHeight="200" />
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource CardStyle}">
                            <Grid RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Loop" Style="{StaticResource PanelHeadingStyle}" />
                                    <TextBlock Grid.Column="1" Text="4 bars"
                                        Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="SelectedTrackText" Grid.Column="2" Text="Velvet keys"
                                        FontSize="12" Foreground="{StaticResource MutedText}"
                                        VerticalAlignment="Center" />
                                </Grid>
                                <Grid x:Name="TimelinePanel" Grid.Row="1" MinHeight="110"
                                    AutomationProperties.Name="Four-track recorded loop" />
                                <ProgressBar x:Name="LoopProgress" Grid.Row="2"
                                    Minimum="0" Maximum="16" Value="0"
                                    Foreground="{StaticResource AccentBrush}"
                                    Background="{StaticResource InsetBackground}"
                                    AutomationProperties.Name="Position within the loop" />
                            </Grid>
                        </Border>
                        <controls:ResizeHandle
                            x:Name="LoopResizeHandle"
                            Grid.Row="1"
                            Axis="Vertical"
                            Style="{StaticResource RowResizeHandleStyle}"
                            ToolTipService.ToolTip="Resize loop and drums"
                            AutomationProperties.Name="Resize loop and drum panels"
                            AutomationProperties.HelpText="Drag up or down, or use the up and down arrow keys." />
                        <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                            <Grid RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Drums" Style="{StaticResource PanelHeadingStyle}" />
                                <Grid x:Name="PadPanel" Grid.Row="1" MinHeight="120" Margin="-4,0"
                                    AutomationProperties.Name="Drum pads" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
                <TextBlock x:Name="StatusText" Grid.Row="3" MinHeight="16" FontSize="12"
                    Foreground="{StaticResource MutedText}" TextWrapping="Wrap"
                    AutomationProperties.LiveSetting="Polite" />
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
